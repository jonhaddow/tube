{
	"name": "tube",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/add-cron.ts",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync && node scripts/gen-types.ts || echo ''",
		"check": "node scripts/gen-types.ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:generate": "drizzle-kit generate",
		"gen": "node scripts/gen-types.ts",
		"db:migrate:local": "wrangler d1 migrations apply tube --local",
		"db:migrate:remote": "wrangler d1 migrations apply tube --remote",
		"deploy": "npm run build && npm run deploy:ci",
		"deploy:ci": "wrangler d1 migrations apply tube --remote && wrangler deploy",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@libsql/client": "^0.18.0",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.6.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.3",
		"wrangler": "^4.153.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.1": true,
		"esbuild@0.18.20": true,
		"workerd@1.20261023.1": true
	},
	"dependencies": {
		"arctic": "^3.7.0",
		"@fontsource/bagel-fat-one": "^5.3.0",
		"@fontsource-variable/lexend": "^5.3.0"
	}
}
